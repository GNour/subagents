#!/usr/bin/env python3
"""Aegis-facing catalog CLI shim for the Subagents companion package.

Runs with the standard library only; no virtualenv or third-party deps required.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from catalog.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
